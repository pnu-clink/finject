{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "alternatives": {
            "type": "string",
            "minLength": 1
          },
          "limitation": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "enum": [
              "ACCEPT_DESCRIPTIVE",
              "DEFER_CAUSAL_CLAIM",
              "DISCUSS_NEXT_TEST"
            ]
          },
          "interpretation_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "display_ko": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1
              },
              "claim": {
                "type": "string",
                "minLength": 1
              },
              "alternatives": {
                "type": "string",
                "minLength": 1
              },
              "limitation": {
                "type": "string",
                "minLength": 1
              },
              "decision": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "title",
              "claim",
              "alternatives",
              "limitation",
              "decision"
            ]
          }
        },
        "required": [
          "id",
          "title",
          "claim",
          "alternatives",
          "limitation",
          "decision",
          "interpretation_ids",
          "display_ko"
        ]
      }
    },
    "discussion": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "proposal": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "const": "NOT_EXECUTED"
          },
          "display_ko": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "proposal": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "proposal",
              "reason"
            ]
          }
        },
        "required": [
          "id",
          "proposal",
          "reason",
          "status",
          "display_ko"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "run",
    "findings",
    "discussion"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResultsResearchFindingsV1"
}
