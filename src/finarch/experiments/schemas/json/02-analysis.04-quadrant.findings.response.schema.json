{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResearchFindingQuadrants",
  "type": "object",
  "properties": {
    "run": {
      "type": "string",
      "minLength": 1
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "display_ko": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1
              },
              "summary": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "title",
              "summary"
            ],
            "additionalProperties": false
          },
          "finding_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "condition_profiles": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "condition": {
                  "type": "string",
                  "enum": [
                    "unguided/off",
                    "unguided/on",
                    "guided/off",
                    "guided/on"
                  ]
                },
                "finding_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "analysis": {
                  "type": "string",
                  "minLength": 1
                },
                "display_ko": {
                  "type": "object",
                  "properties": {
                    "analysis": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "analysis"
                  ],
                  "additionalProperties": false
                },
                "citations": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "finding_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "field": {
                        "type": "string",
                        "enum": [
                          "claim",
                          "alternatives",
                          "limitation"
                        ]
                      },
                      "quote": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "finding_id",
                      "field",
                      "quote"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "condition",
                "finding_ids",
                "analysis",
                "display_ko",
                "citations"
              ],
              "additionalProperties": false
            },
            "minItems": 4,
            "maxItems": 4
          }
        },
        "required": [
          "id",
          "title",
          "summary",
          "display_ko",
          "finding_ids",
          "condition_profiles"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "run",
    "groups"
  ],
  "additionalProperties": false
}
